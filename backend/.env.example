PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sufi_institute
# Only needed when connecting to a provider that requires SSL (e.g. Aiven) —
# path to the CA certificate file they give you. Leave unset for local MySQL.
DB_SSL_CA_PATH=

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Gmail SMTP - use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Sufi Infotech <your_email@gmail.com>"

# Frontend URL (for CORS + links in emails)
FRONTEND_URL=http://localhost:5173

# Razorpay (fill in when payment module is wired up)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
